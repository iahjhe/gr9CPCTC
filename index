<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Congruent Triangles: CPCTC Lesson</title>
<style>
:root{--bg:#f3f7f4;--card:#fff;--ink:#17322b;--mut:#587068;--line:#cfdcd5;--acc:#e8590c;--grn:#2b8a3e;--red:#c92a2a;--tri:#0b7285;--tri2:#e9f5f7;
box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){--bg:#0f1c18;--card:#172a24;--ink:#e6f2ec;--mut:#9bb5aa;--line:#2c4a40;--acc:#ff922b;--grn:#69db7c;--red:#ff8787;--tri:#3bc9db;--tri2:#12333a}}
:root[data-theme="dark"]{--bg:#0f1c18;--card:#172a24;--ink:#e6f2ec;--mut:#9bb5aa;--line:#2c4a40;--acc:#ff922b;--grn:#69db7c;--red:#ff8787;--tri:#3bc9db;--tri2:#12333a}
html{scroll-padding-top:env(safe-area-inset-top,0px)}
*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--ink);font:17px/1.55 Georgia,"Times New Roman",serif}
main{max-width:860px;margin:0 auto;padding:16px}
h1{font-size:1.7rem;margin:.2em 0}h2{font-size:1.3rem;margin:.2em 0 .5em}
p{margin:.4em 0}
nav{display:flex;gap:6px;flex-wrap:wrap;margin:10px 0 16px}
nav button,.btn{font:inherit;font-family:system-ui,sans-serif;font-weight:600;border:2px solid var(--line);background:var(--card);color:var(--ink);padding:8px 14px;border-radius:10px;cursor:pointer}
nav button.on,.btn.pri{background:var(--tri);border-color:var(--tri);color:#fff}
button:focus-visible{outline:3px solid var(--acc);outline-offset:2px}
.card{background:var(--card);border:2px solid var(--line);border-radius:14px;padding:16px;margin-bottom:14px}
.row{display:flex;gap:14px;flex-wrap:wrap;align-items:center;justify-content:center}
.tri{width:min(100%,260px);height:auto;background:var(--tri2);border-radius:12px}
.tri line{stroke:var(--tri);stroke-width:3;stroke-linecap:round}
.tri line.on{stroke:var(--acc);stroke-width:6}
.tri circle{fill:none}.tri circle.on{fill:var(--acc);opacity:.35}
.tri text{fill:var(--ink);font:600 11px system-ui,sans-serif}
.tri .nm{font-size:14px;fill:var(--tri)}
.tri text.on{fill:var(--acc)}
.cong{font-size:2rem;color:var(--mut)}
.chips{display:flex;gap:8px;flex-wrap:wrap;justify-content:center;margin:12px 0}
.chip{font:700 1.1rem system-ui,sans-serif;min-width:54px;padding:10px 12px;border-radius:10px;border:2px dashed var(--tri);background:var(--card);color:var(--tri);cursor:pointer}
.chip.open{background:var(--tri);color:#fff;border-style:solid}
.pairs{display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:8px;margin-top:10px}
.pairs button{font:inherit;text-align:left;padding:10px;border-radius:10px;border:2px solid var(--line);background:var(--card);color:var(--ink);cursor:pointer}
.pairs button.on{border-color:var(--acc);background:var(--tri2)}
.steps li{margin:.5em 0}
.hint{color:var(--mut);font-size:.95rem}
.ok{color:var(--grn)}.bad{color:var(--red)}
.opts{display:grid;gap:8px;margin:12px 0}
.opts button{font:inherit;text-align:left;padding:12px;border-radius:10px;border:2px solid var(--line);background:var(--card);color:var(--ink);cursor:pointer}
.opts button.right{border-color:var(--grn);background:var(--tri2)}
.opts button.wrong{border-color:var(--red)}
.bar{height:10px;background:var(--line);border-radius:6px;overflow:hidden}.bar i{display:block;height:100%;background:var(--acc);transition:width .3s}
.big{font-size:2.6rem;font-weight:700;color:var(--acc);text-align:center}
@media (prefers-reduced-motion:reduce){*{transition:none!important}}
</style>
</head>
<body>
<main>
<h1>△ Congruent Triangles & CPCTC</h1>
<p class="hint">Learn it, play with it, then test yourself.</p>
<nav id="nav"></nav>
<div id="app"></div>
</main>
<script>
const $=s=>document.querySelector(s);
const P=[[40,130],[180,130],[110,28]];
// Draw a triangle. n=vertex names, a=angle labels, s=side labels, hl=highlighted part (0-2 angles, 3-5 sides)
function tri(n,a=[],s=[],hl=-1){
 const c=[(P[0][0]+P[1][0]+P[2][0])/3,(P[0][1]+P[1][1]+P[2][1])/3];
 let o='<svg class="tri" viewBox="0 0 220 165" role="img" aria-label="Triangle '+n.join('')+'">';
 for(let i=0;i<3;i++){const p=P[i],q=P[(i+1)%3];
  o+=`<line class="${hl===3+i?'on':''}" x1="${p[0]}" y1="${p[1]}" x2="${q[0]}" y2="${q[1]}"/>`;
  const m=[(p[0]+q[0])/2,(p[1]+q[1])/2],dx=m[0]-c[0],dy=m[1]-c[1],L=Math.hypot(dx,dy)||1;
  const x=m[0]+dx/L*10,y=m[1]+dy/L*10+(i==0?8:0);
  o+=`<text class="${hl===3+i?'on':''}" x="${x}" y="${y}" text-anchor="${i==1?'start':i==2?'end':'middle'}">${s[i]||''}</text>`}
 for(let i=0;i<3;i++){const p=P[i],dx=p[0]-c[0],dy=p[1]-c[1],L=Math.hypot(dx,dy);
  o+=`<circle class="${hl===i?'on':''}" cx="${p[0]}" cy="${p[1]}" r="20" stroke="var(--tri)" stroke-width="${hl===i?0:1}" stroke-dasharray="2 3"/>`;
  o+=`<text class="nm" x="${p[0]+dx/L*14-4}" y="${p[1]+dy/L*14+5}">${n[i]}</text>`;
  o+=`<text class="${hl===i?'on':''}" x="${p[0]-dx/L*30}" y="${p[1]-dy/L*30+4}" text-anchor="middle">${a[i]||''}</text>`}
 return o+'</svg>'}
const pair=(L,R,hl)=>`<div class="row">${tri(L.n,L.a,L.s,hl)}<span class="cong">≅</span>${tri(R.n,R.a,R.s,hl)}</div>`;

/* ---------- LEARN ---------- */
const chips=[["C","Corresponding"],["P","Parts"],["of"],["C","Congruent"],["T","Triangles"],["are"],["C","Congruent"]];
function learn(){
 $('#app').innerHTML=`
 <div class="card"><h2>What does congruent mean?</h2>
 <p>Two triangles are <b>congruent</b> when they have the <b>same shape and the same size</b>. You could slide, flip or turn one so it sits exactly on top of the other.</p>
 ${pair({n:['A','B','C'],a:['','',''],s:['','','']},{n:['D','E','F'],a:['','',''],s:['','','']})}
 <p class="hint">△ABC ≅ △DEF means the symbol ≅ “is congruent to”.</p></div>
 <div class="card"><h2>CPCTC: tap each box to reveal it</h2>
 <div class="chips" id="chips">${chips.map((c,i)=>`<button class="chip" data-i="${i}">${c[0]}${c[1]?'___':''}</button>`).join('')}</div>
 <p id="cp" class="hint">Corresponding Parts of Congruent Triangles are Congruent.</p>
 <p><b>Meaning:</b> if two triangles are congruent, every matching angle is equal and every matching side is equal. That gives <b>6 pairs</b>: 3 angles and 3 sides.</p></div>
 <div class="card"><h2>3 steps to solve any problem</h2>
 <ol class="steps"><li><b>Match the parts.</b> The order of the letters tells you who matches who.</li>
 <li><b>Set matching parts equal</b> and solve the equation.</li>
 <li><b>Need a missing angle?</b> The angles of a triangle add up to 180°.</li></ol>
 <button class="btn pri" onclick="go(1)">Next: match the parts</button></div>`;
 document.querySelectorAll('.chip').forEach(b=>b.onclick=()=>{const c=chips[b.dataset.i];if(c[1]){b.textContent=c[1];b.classList.add('open')}})}

/* ---------- MATCH ---------- */
const NL={n:['N','I','M'],a:['28°','92°','60°'],s:['NI = 4 ft','IM = 3 ft','MN = 5 ft']};
const ZR={n:['Z','E','R'],a:['?','?','?'],s:['ZE = ?','ER = ?','RZ = ?']};
const pr=[['∠N ≅ ∠Z','If ∠N = 28°, then ∠Z = 28°',0,'28°'],['∠I ≅ ∠E','If ∠I = 92°, then ∠E = 92°',1,'92°'],['∠M ≅ ∠R','If ∠M = 60°, then ∠R = 60°',2,'60°'],
['NI ≅ ZE','If NI = 4 ft, then ZE = 4 ft',3,'4 ft'],['IM ≅ ER','If IM = 3 ft, then ER = 3 ft',4,'3 ft'],['MN ≅ RZ','If MN = 5 ft, then RZ = 5 ft',5,'5 ft']];
function match(k=-1){
 const R={n:ZR.n,a:[...ZR.a],s:[...ZR.s]};
 if(k>=0){const v=pr[k][3];k<3?R.a[k]=v:R.s[k-3]=v+'';}
 $('#app').innerHTML=`<div class="card"><h2>△NIM ≅ △ZER: tap a pair</h2>
 <p>Letters match in order: <b>N↔Z, I↔E, M↔R</b>. Tap a pair to see the matching parts light up.</p>
 ${pair(NL,R,k)}
 <p id="say" style="text-align:center;font-weight:700;min-height:1.6em;color:var(--acc)">${k>=0?pr[k][1]:''}</p>
 <div class="pairs">${pr.map((p,i)=>`<button class="${i===k?'on':''}" data-i="${i}">${p[0]}</button>`).join('')}</div>
 <p class="hint">Real-life example: the roof truss in your notes is built from two congruent triangles, so both sides of the roof match.</p>
 <button class="btn pri" onclick="go(2)">Next: worked examples</button></div>`;
 document.querySelectorAll('.pairs button').forEach(b=>b.onclick=()=>match(+b.dataset.i))}

/* ---------- EXAMPLES ---------- */
const EX=[
{t:'Find ∠H',g:'△IEF ≅ △HGF, ∠I = 40°',hl:0,L:{n:['I','E','F'],a:['40°','','']},R:{n:['H','G','F'],a:['?','','']},
 st:['Match the letters in order: I↔H, E↔G, F↔F.','So ∠I and ∠H are corresponding angles.','By CPCTC, ∠H = ∠I = <b>40°</b>.']},
{t:'Find y',g:'△ABC ≅ △ADC, AB = 3y cm, AD = 18 cm',hl:3,L:{n:['A','B','C'],s:['AB = 3y','','']},R:{n:['A','D','C'],s:['AD = 18','','']},
 st:['AB and AD are corresponding sides, so AB ≅ AD.','Set them equal: 3y = 18.','Divide both sides by 3: y = <b>6</b>.']},
{t:'Find n and ∠L',g:'△JOY ≅ △FUL, ∠J = 60°, ∠O = 70°, ∠U = (2n+10)°',hl:1,L:{n:['J','O','Y'],a:['60°','70°','?']},R:{n:['F','U','L'],a:['','(2n+10)°','?']},
 st:['∠O ↔ ∠U, so 2n + 10 = 70.','Subtract 10: 2n = 60, so n = <b>30</b>.','In △JOY: ∠Y = 180° − 60° − 70° = 50°.','∠L ↔ ∠Y, so ∠L = <b>50°</b>.']},
{t:'Find ∠X',g:'△MYX ≅ △JAN, ∠M = 40°, ∠A = 70°',hl:1,L:{n:['M','Y','X'],a:['40°','?','?']},R:{n:['J','A','N'],a:['','70°','']},
 st:['M↔J, Y↔A, X↔N.','∠Y ≅ ∠A, so ∠Y = 70°.','Angles add to 180°: 40° + 70° + ∠X = 180°.','110° + ∠X = 180°, so ∠X = <b>70°</b>.']},
{t:'Find x and ∠EOB',g:'△BOE ≅ △TXE, ∠BEO = (4x−2)°, ∠XET = (3x+23)°, ∠OBE = (2x−5)°',hl:2,L:{n:['B','O','E'],a:['(2x−5)°','?','(4x−2)°']},R:{n:['T','X','E'],a:['','','(3x+23)°']},
 st:['∠BEO ≅ ∠XET, so 4x − 2 = 3x + 23.','Subtract 3x, add 2: x = <b>25</b>.','∠BEO = 4(25) − 2 = 98°.','∠OBE = 2(25) − 5 = 45°.','∠EOB = 180° − 98° − 45° = <b>37°</b>.']}];
let ei=0,es=0;
function ex(){
 const e=EX[ei];
 $('#app').innerHTML=`<div class="card"><div class="row" style="justify-content:flex-start">${EX.map((x,i)=>`<button class="btn ${i===ei?'pri':''}" data-i="${i}">Ex ${i+1}</button>`).join('')}</div></div>
 <div class="card"><h2>${e.t}</h2><p><b>Given:</b> ${e.g}</p>${pair(e.L,e.R,es>0?e.hl:-1)}
 <ol class="steps">${e.st.slice(0,es).map(s=>`<li>${s}</li>`).join('')}</ol>
 ${es<e.st.length?`<button class="btn pri" id="nx">Show step ${es+1}</button>`:`<p class="ok"><b>Solved!</b></p>${ei<EX.length-1?'<button class="btn" id="ne">Next example</button>':'<button class="btn pri" id="q">Take the quiz</button>'}`}</div>`;
 document.querySelectorAll('.card .btn[data-i]').forEach(b=>b.onclick=()=>{ei=+b.dataset.i;es=0;ex()});
 const f=(id,fn)=>{const b=$(id);if(b)b.onclick=fn};
 f('#nx',()=>{es++;ex()});f('#ne',()=>{ei++;es=0;ex()});f('#q',()=>go(3))}

/* ---------- QUIZ ---------- */
const Q=[
{q:'What does CPCTC stand for?',o:['Corresponding Parts of Congruent Triangles are Congruent','Common Points of Closed Triangles are Complete','Corners, Peaks, and Cuts of Triangles are Constant','Congruent Parts of Corresponding Triangles are Correct'],a:0,w:'CPCTC = Corresponding Parts of Congruent Triangles are Congruent.'},
{q:'△IEF ≅ △HGF and ∠I = 40°. What is ∠H?',o:['50°','40°','140°','80°'],a:1,w:'I and H match, so ∠H = ∠I = 40°.'},
{q:'△ABC ≅ △ADC with AB = 3y and AD = 18. What is y?',o:['15','54','6','3'],a:2,w:'3y = 18, so y = 18 ÷ 3 = 6.'},
{q:'△JOY ≅ △FUL and ∠O = 70° = (2n+10)°. What is n?',o:['30','40','35','60'],a:0,w:'2n + 10 = 70, so 2n = 60 and n = 30.'},
{q:'△MYX ≅ △JAN, ∠M = 40°, ∠A = 70°. What is ∠X?',o:['40°','110°','70°','30°'],a:2,w:'∠Y = ∠A = 70°. Then 180° − 40° − 70° = 70°.'},
{q:'△ABC ≅ △STU, AB = 3 cm. Which side is also 3 cm?',o:['TU','SU','ST','BC'],a:2,w:'A↔S and B↔T, so AB matches ST.'},
{q:'Matching sides are 7x − 4 and 31. What is x?',o:['5','4','35','7'],a:0,w:'7x − 4 = 31, so 7x = 35 and x = 5.'},
{q:'In a triangle, two angles are 98° and 45°. What is the third?',o:['37°','47°','143°','27°'],a:0,w:'180° − 98° − 45° = 37°.'},
{q:'Matching sides are (5h − 7) and (3h + 21). What is h?',o:['7','14','10','28'],a:1,w:'5h − 7 = 3h + 21, so 2h = 28 and h = 14.'}];
let qi=0,sc=0,done=false;
function quiz(){
 if(qi>=Q.length){const m=sc>=8?'Congruence champion!':sc>=5?'Good work. Review the steps you missed.':'Keep practicing. Try the examples again.';
  $('#app').innerHTML=`<div class="card"><h2>Quiz complete</h2><div class="big">${sc} / ${Q.length}</div><p style="text-align:center">${m}</p><div class="row"><button class="btn pri" id="r">Try again</button><button class="btn" onclick="go(2)">Review examples</button></div></div>`;
  $('#r').onclick=()=>{qi=0;sc=0;quiz()};return}
 const q=Q[qi];done=false;
 $('#app').innerHTML=`<div class="card"><div class="bar"><i style="width:${qi/Q.length*100}%"></i></div><p class="hint">Question ${qi+1} of ${Q.length} · Score ${sc}</p>
 <h2>${q.q}</h2><div class="opts">${q.o.map((t,i)=>`<button data-i="${i}">${t}</button>`).join('')}</div><div id="fb"></div></div>`;
 document.querySelectorAll('.opts button').forEach(b=>b.onclick=()=>{
  if(done)return;done=true;const i=+b.dataset.i,ok=i===q.a;if(ok)sc++;
  b.classList.add(ok?'right':'wrong');document.querySelectorAll('.opts button')[q.a].classList.add('right');
  $('#fb').innerHTML=`<p class="${ok?'ok':'bad'}"><b>${ok?'Correct!':'Not quite.'}</b> ${q.w}</p><button class="btn pri" id="n">${qi<Q.length-1?'Next question':'See results'}</button>`;
  $('#n').onclick=()=>{qi++;quiz()}})}

/* ---------- NAV ---------- */
const tabs=[['Learn',learn],['Match',()=>match()],['Examples',ex],['Quiz',quiz]];
function go(i){document.querySelectorAll('#nav button').forEach((b,j)=>b.classList.toggle('on',i===j));tabs[i][1]();window.scrollTo(0,0)}
$('#nav').innerHTML=tabs.map((t,i)=>`<button>${t[0]}</button>`).join('');
document.querySelectorAll('#nav button').forEach((b,i)=>b.onclick=()=>go(i));
go(0);
</script>
</body>
</html>
